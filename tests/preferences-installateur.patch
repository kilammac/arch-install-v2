diff --git a/install/lib/ui.sh b/install/lib/ui.sh
index 1a498f9..6496495 100644
--- a/install/lib/ui.sh
+++ b/install/lib/ui.sh
@@ -151 +151 @@ uiMulti() {
-  local __var="$1" header="$2" selected="$3" value reply
+  local __var="$1" header="$2" selected="$3" value reply option selected_options=()
@@ -154,2 +154,11 @@ uiMulti() {
-    value="$(printf '%s\n' "$@" | gum choose --no-limit --header "$header" \
-      --height "$UI_LIST_HEIGHT" --selected "$selected")" || return 1
+    # Les libellés peuvent contenir des virgules. Ne pas les transmettre à
+    # --selected, qui découperait chaque libellé en plusieurs valeurs.
+    for option in "$@"; do
+      if [[ ",${selected}," == *",${option},"* ]]; then
+        selected_options+=("$option")
+      fi
+    done
+    # Options en arguments, présélections séparées par des retours à la ligne.
+    value="$(printf '%s\n' "${selected_options[@]}" | env -u GUM_CHOOSE_SELECTED \
+      gum choose --no-limit --header "$header" --height "$UI_LIST_HEIGHT" \
+      --input-delimiter $'\n' --output-delimiter $'\n' -- "$@")" || return 1
diff --git a/install/lib/user.sh b/install/lib/user.sh
index 713d361..941e01f 100644
--- a/install/lib/user.sh
+++ b/install/lib/user.sh
@@ -8,0 +9 @@ FISHER_URL="https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions
+OH_MY_BASH_URL="https://raw.githubusercontent.com/ohmybash/oh-my-bash/master/tools/install.sh"
@@ -112,0 +114,18 @@ userFish() {
+userOhMyBash() {
+  if ((!DRY_RUN)) && [[ -f "${MNT}/home/${A_USER}/.oh-my-bash/oh-my-bash.sh" ]]; then
+    echo "Oh My Bash already installed"
+    return 0
+  fi
+  if ((DRY_RUN)); then
+    asUser env -u OSH -u OSH_REPOSITORY bash -c 'installer=$(curl -fsSL "$1") || exit; bash -c "$installer"' _ "$OH_MY_BASH_URL"
+    return
+  fi
+  if ! { : </dev/tty; } 2>/dev/null; then
+    echo "Oh My Bash needs an interactive terminal. Run the installer from the ISO terminal." >&2
+    return 1
+  fi
+  # L'étape verbose garde la progression d'origine ; /dev/tty restitue
+  # l'entrée interactive que les tâches en arrière-plan redirigent normalement.
+  asUser env -u OSH -u OSH_REPOSITORY bash -c 'installer=$(curl -fsSL "$1") || exit; bash -c "$installer"' _ "$OH_MY_BASH_URL" </dev/tty
+}
